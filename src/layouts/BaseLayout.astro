---
import '@fontsource-variable/fraunces';
import '@fontsource-variable/geist';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';
import { localeMeta, localizedPath, type Locale } from '../i18n';

interface Props {
  title: string;
  description?: string;
  jsonLd?: object | object[];
  ogType?: string;
  path?: string;
  locale?: Locale;
  alternateEnPath?: string;
  alternateEsPath?: string;
}

const {
  title,
  description = site.description,
  jsonLd,
  ogType = 'website',
  path,
  locale = 'en',
  alternateEnPath,
  alternateEsPath,
} = Astro.props;

const copy = localeMeta[locale];
const canonicalPath = path ?? Astro.url.pathname;
const canonical = new URL(canonicalPath, site.url);
const englishPath = alternateEnPath ?? localizedPath(canonicalPath, 'en');
const spanishPath = alternateEsPath ?? localizedPath(canonicalPath, 'es');
const englishUrl = new URL(englishPath, site.url);
const spanishUrl = new URL(spanishPath, site.url);
const fullTitle = title.includes(site.name) ? title : `${title} — ${site.name}`;
const ogImage = new URL('/og.jpg', site.url);
const ogImageAlt = locale === 'es'
  ? `${site.name} — Sitios web que la gente puede encontrar. Software hecho para durar.`
  : `${site.name} — ${site.tagline}`;

const ldArray = jsonLd
  ? Array.isArray(jsonLd)
    ? jsonLd
    : [jsonLd]
  : [];
---

<!doctype html>
<html lang={copy.htmlLang} data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark light" />
    <script is:inline>
      (() => {
        let theme;
        try { theme = localStorage.getItem('theme'); } catch {}
        if (theme !== 'light' && theme !== 'dark') {
          theme = matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
        }
        document.documentElement.dataset.theme = theme;
        document.documentElement.style.colorScheme = theme;
      })();
    </script>
    {Astro.url.pathname === '/' && (
      <script is:inline>
        (() => {
          let choice;
          try { choice = localStorage.getItem('locale'); } catch {}
          const wantsSpanish = navigator.languages?.some((language) => language.toLowerCase().startsWith('es'))
            ?? navigator.language.toLowerCase().startsWith('es');
          if (choice === 'es' || (!choice && wantsSpanish)) location.replace('/es/');
        })();
      </script>
    )}

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={englishUrl} />
    <link rel="alternate" hreflang="es-MX" href={spanishUrl} />
    <link rel="alternate" hreflang="x-default" href={englishUrl} />
    <meta name="generator" content={Astro.generator} />

    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:locale" content={copy.ogLocale} />
    <meta property="og:locale:alternate" content={locale === 'es' ? 'en_US' : 'es_MX'} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Person',
      name: site.name,
      alternateName: site.handle,
      url: site.url,
      email: `mailto:${site.email}`,
      jobTitle: locale === 'es' ? 'Desarrollador full-stack' : 'Full-Stack Developer',
      address: {
        '@type': 'PostalAddress',
        addressCountry: 'MX',
      },
      knowsAbout: [
        'Web development',
        'Search engine optimization',
        'React',
        'Django',
        'Astro',
        'PostgreSQL',
        'Web application security',
      ],
      sameAs: [site.github],
    })} />
    {ldArray.map((ld) => (
      <script type="application/ld+json" set:html={JSON.stringify(ld)} />
    ))}

    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  </head>
  <body>
    <!--
      THESIS: The first screen is a classified dossier opened to one line — websites that get found — with a violet file tab. It keeps the expediente ritual but goes stealthy and tactile.
      OWN-WORLD: Kinetic Tactile / Dark Luxury Dossier. Matte onyx #161616 fields, charcoal plates #202022, bone typography #ECE7DE, clearance purple #7C4FE0 as folder fields. Fraunces display, Geist labels. Frosted sticky header, die-cut tabs, tactile press states, folder lift on hover.
      STORY: A small-business owner opens a dossier that feels deliberate and valuable, trusts the work is careful, and emails to start.
      FIRST VIEWPORT: Sticky frosted header. Huge left-stacked offer. Dark field. One violet tab at the bottom: WORK / 04 FILES. Primary action is Start a project in the header.
      FORM: Expediente (grounded 4), staging offer-then-rising-files, seed 8c2f6b41.
    -->
    <a class="skip-link" href="#main">{copy.skip}</a>
    <Header locale={locale} languageSwitchPath={locale === 'es' ? englishPath : spanishPath} />
    <main id="main">
      <slot />
    </main>
    <Footer locale={locale} />
  </body>
</html>
