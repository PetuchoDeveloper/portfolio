---
interface Props {
  src: string;
  alt: string;
  width: number;
  height: number;
  caption?: string;
  product?: boolean;
}
const { src, alt, width, height, caption, product = false } = Astro.props;
---

<figure class:list={['still', product && 'still--product']}>
  <img src={src} alt={alt} width={width} height={height} decoding="async" />
  {caption && <figcaption>{caption}</figcaption>}
</figure>
