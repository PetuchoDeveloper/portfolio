---
import { site } from '../data/site';
import { localeMeta, localizedNav, localizedPath, type Locale } from '../i18n';

interface Props { locale?: Locale; }
const { locale = 'en' } = Astro.props;
const copy = localeMeta[locale];
const nav = localizedNav[locale];
const year = new Date().getFullYear();
const tagline = locale === 'es'
  ? 'Sitios web fáciles de encontrar. Software hecho para durar.'
  : site.tagline;
---

<footer class="site-footer" data-inkpad>
  <canvas class="ink-canvas" aria-hidden="true"></canvas>
  <div class="wrap footer-top">
    <div class="footer-mark">
      <p class="footer-lead">{copy.leaveMark.slice(0, -1)}<span class="mark">{copy.leaveMark.slice(-1)}</span></p>
      <p class="footer-hint">{copy.inkHint}</p>
      <a class="btn btn--solid" href={localizedPath('/contact/', locale)}>{copy.startProject}</a>
    </div>
    <div class="footer-cols">
      <div>
        <p class="col-label">{copy.site}</p>
        <ul>
          {nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
          <li><a href={localizedPath('/contact/', locale)}>{copy.contact}</a></li>
        </ul>
      </div>
      <div>
        <p class="col-label">{copy.elsewhere}</p>
        <ul>
          <li><a href={site.github} rel="me noopener" target="_blank">GitHub</a></li>
          <li><a href={`mailto:${site.email}`}>{copy.email}</a></li>
        </ul>
      </div>
      <div>
        <p class="col-label">{copy.contact}</p>
        <ul>
          <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
          <li class="muted">{site.location} · {copy.languages.join(' / ')}</li>
        </ul>
      </div>
      <div class="footer-meta">
        <span>© {year} {site.name}. {tagline}</span>
        <span>{copy.built}</span>
      </div>
    </div>
  </div>

  <p class="wrap footer-wordmark" aria-hidden="true">{site.name}</p>
</footer>

<script>
  import { mountInkpad } from '../scripts/inkpad';
  document.querySelectorAll<HTMLElement>('[data-inkpad]').forEach(mountInkpad);
</script>
