---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site, services } from '../data/site';
import { getCollection } from 'astro:content';
import Still from '../components/Still.astro';
import SitePlate from '../components/SitePlate.astro';
import MethodRail from '../components/MethodRail.astro';

const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const heroJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: site.name,
  description: site.description,
  url: site.url,
  email: site.email,
  areaServed: 'Worldwide',
  serviceType: ['Web development', 'Small business websites', 'Full-stack web applications', 'SEO'],
};

const concept = 'Conceptual image generated for this page; not a client photograph.';
---

<BaseLayout
  title={site.name}
  description={site.description}
  jsonLd={heroJsonLd}
>
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <p class="file-kicker">Case file — Petucho</p>
        <h1 class="display">
          Websites<br />that get<br />found.
        </h1>
      </div>
      <div class="hero-art" aria-hidden="true">
        <img
          src="/images/hero-web-spider.webp"
          alt=""
          width="1400"
          height="2100"
          loading="eager"
          decoding="async"
        />
      </div>
    </div>
  </section>

  <div class="file-stack">
    <article class="file file--orchid" id="work">
      <p class="file-tab tab-label">Work / 04 files</p>
      <div class="wrap">
        <div class="media-split" style="margin-top:0">
          <div>
            <p class="file-kicker">Selected work</p>
            <h2 class="h2">One public file. Three in write-up.</h2>
            <p class="lede" style="margin-top:1.1rem">
              SED is institutional software. I bring the same discipline
              to a small-business website.
            </p>
            <div class="work-rows">
              <a class="work-row" href="/work/sed/">
                <div>
                  <strong>SED — Teacher Evaluation System</strong>
                  <p class="muted">Anonymous platform for a public Mexican university. 2,500+ tests.</p>
                </div>
                <span>Read →</span>
              </a>
              <div class="work-row">
                <div>
                  <strong>Video streaming stack</strong>
                  <p class="muted">Write-up in progress. Django, React, Rust worker.</p>
                </div>
                <span class="muted">Pending</span>
              </div>
              <div class="work-row">
                <div>
                  <strong>Marketplace operations</strong>
                  <p class="muted">Write-up in progress. Spanish-first control plane.</p>
                </div>
                <span class="muted">Pending</span>
              </div>
              <div class="work-row">
                <div>
                  <strong>Automation verification gate</strong>
                  <p class="muted">Write-up in progress. Stops silent false positives.</p>
                </div>
                <span class="muted">Pending</span>
              </div>
            </div>
            <p style="margin-top:1.75rem">
              <a class="link-arrow" href="/work/">Open the work folder →</a>
            </p>
          </div>
          <Still
            src="/images/folders.webp"
            alt={concept}
            width={1400}
            height={933}
            caption="The expediente: four files. Only SED is written up in public."
          />
        </div>
      </div>
    </article>

    <article class="file" id="offer">
      <p class="file-tab tab-label">Offer</p>
      <div class="wrap">
        <p class="file-kicker">What you get</p>
        <h2 class="h2">A site customers can actually find.</h2>
        <p class="lede" style="margin-top:1.1rem">
          {services[0].summary}
        </p>
        <div class="media-split">
          <Still
            src="/images/shopfront.webp"
            alt={concept}
            width={1400}
            height={788}
            caption="A shop that can be found. Generated concept, not a client storefront."
          />
          <div>
            <SitePlate />
            <p class="muted" style="margin-top:1.5rem">
              Full-stack applications are the second offer. Security review is
              included in those builds, not sold as a standalone audit.
            </p>
            <p style="margin-top:1.25rem">
              <a class="link-arrow" href="/services/">See both offers →</a>
            </p>
          </div>
        </div>
      </div>
    </article>

    <article class="file file--kraft" id="method">
      <p class="file-tab tab-label">How I work</p>
      <div class="wrap">
        <p class="file-kicker">Method</p>
        <h2 class="h2">No black boxes.</h2>
        <p class="lede" style="margin-top:1.1rem; margin-bottom:1.75rem">
          Four files in the engagement. You approve each one.
        </p>
        <MethodRail />
      </div>
    </article>

    <article class="file file--orchid" id="start">
      <p class="file-tab tab-label">Start</p>
      <div class="wrap">
        <div class="media-split" style="margin-top:0">
          <div>
            <p class="file-kicker">Next</p>
            <h2 class="h2">Have a project? Tell me about it.</h2>
            <p class="lede" style="margin-top:1.1rem">
              I reply within one business day. English or Spanish.
            </p>
            <div style="display:flex; flex-wrap:wrap; gap:0.8rem; margin-top:2rem">
              <a class="btn btn--solid" href="/contact/">Start a project</a>
              <a class="btn" href={`mailto:${site.email}`}>{site.email}</a>
            </div>
          </div>
          <Still
            src="/images/found-street.webp"
            alt={concept}
            width={1400}
            height={933}
            caption="The one door that gets found. Generated concept."
          />
        </div>
      </div>
    </article>
  </div>

  {posts.length > 0 && (
    <section class="page-hero" style="padding-top:clamp(3rem,7vw,5rem)">
      <div class="wrap">
        <p class="file-kicker">Notes</p>
        <h2 class="h2">Writing about the craft.</h2>
        <div class="post-list" style="margin-top:1.75rem">
          {posts.map((post) => (
            <a class="post-row" href={`/blog/${post.id}/`}>
              <div>
                <h3 class="h3">{post.data.title}</h3>
                <p class="muted" style="font-size:0.9375rem">{post.data.description}</p>
              </div>
              <time datetime={post.data.pubDate.toISOString()}>
                {post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
              </time>
            </a>
          ))}
        </div>
        <p style="margin-top:1.5rem">
          <a class="link-arrow" href="/blog/">All notes →</a>
        </p>
      </div>
    </section>
  )}
</BaseLayout>
