---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site, services } from '../data/site';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const heroJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: site.name,
  description: site.description,
  url: site.url,
  email: site.email,
  areaServed: 'Worldwide',
  serviceType: ['Web development', 'Small business websites', 'Full-stack web applications', 'SEO'],
};
---

<BaseLayout
  title={site.name}
  description={site.description}
  jsonLd={heroJsonLd}
>
  <!-- HERO — Bynario-style: dark, oversized headline, quiet meta -->
  <section class="section" style="padding-top:clamp(4rem,9vw,7rem)">
    <div class="wrap">
      <p class="eyebrow">Full-stack developer · {site.location} · working worldwide</p>
      <h1 class="display" style="margin-top:1.25rem; max-width:20ch">
        Websites that get <span class="serif">found.</span><br />
        Software that holds&nbsp;up.
      </h1>
      <p class="lede" style="margin-top:1.75rem">
        I build fast, search-friendly websites for small businesses and
        production-grade web applications for teams that can't afford
        regressions. Design, code, deployment — one accountable person.
      </p>
      <div style="display:flex; flex-wrap:wrap; gap:0.9rem; margin-top:2.25rem">
        <a class="btn btn--solid" href="/contact/">Start a project</a>
        <a class="btn" href="/work/">See the work</a>
      </div>

      <div
        style="display:flex; flex-wrap:wrap; gap:2.5rem 4rem; margin-top:clamp(3rem,6vw,5rem); padding-top:1.75rem; border-top:1px solid var(--line)"
      >
        <div>
          <p class="h3" style="color:var(--wisteria)">1,750+</p>
          <p class="faint" style="font-size:0.875rem">automated backend tests<br />on my flagship project</p>
        </div>
        <div>
          <p class="h3" style="color:var(--wisteria)">830+</p>
          <p class="faint" style="font-size:0.875rem">frontend tests in the<br />same codebase</p>
        </div>
        <div>
          <p class="h3" style="color:var(--wisteria)">&lt;1s</p>
          <p class="faint" style="font-size:0.875rem">target page load on<br />every site I ship</p>
        </div>
        <div>
          <p class="h3" style="color:var(--wisteria)">2</p>
          <p class="faint" style="font-size:0.875rem">languages shipped:<br />English &amp; Spanish</p>
        </div>
      </div>
    </div>
  </section>

  <!-- WHAT I DO -->
  <section class="section" style="border-top:1px solid var(--line)">
    <div class="wrap">
      <p class="eyebrow">What I do</p>
      <h2 class="h2" style="margin-top:0.9rem; max-width:24ch">
        Two things, done properly.
      </h2>
      <div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(280px,1fr)); gap:1.25rem; margin-top:2.5rem">
        {services.map((s) => (
          <article class="card">
            <div style="display:flex; justify-content:space-between; align-items:baseline; gap:1rem">
              <h3 class="h3">{s.name}</h3>
              <span class="tag">{s.priority}</span>
            </div>
            <p class="muted" style="margin-top:0.9rem">{s.summary}</p>
            <p style="margin-top:1.5rem">
              <a class="link-arrow" href="/services/">Details →</a>
            </p>
          </article>
        ))}
        <article class="card">
          <div style="display:flex; justify-content:space-between; align-items:baseline; gap:1rem">
            <h3 class="h3">Security reviews</h3>
            <span class="tag">Included free</span>
          </div>
          <p class="muted" style="margin-top:0.9rem">
            Every application I build ships with a security pass: auth flows,
            session handling, and data protection checked before launch.
            I also study smart-contract security — ask me about it.
          </p>
          <p style="margin-top:1.5rem">
            <a class="link-arrow" href="/about/">How I work →</a>
          </p>
        </article>
      </div>
    </div>
  </section>

  <!-- FEATURED WORK -->
  <section class="section" style="border-top:1px solid var(--line)">
    <div class="wrap">
      <div style="display:flex; justify-content:space-between; align-items:baseline; flex-wrap:wrap; gap:1rem">
        <div>
          <p class="eyebrow">Selected work</p>
          <h2 class="h2" style="margin-top:0.9rem">Built for real institutions.</h2>
        </div>
        <a class="link-arrow" href="/work/">All work →</a>
      </div>

      <a class="card card--link split split--wide" href="/work/sed/" style="margin-top:2.5rem">
        <div>
          <p class="eyebrow" style="color:var(--text-faint)">Flagship · Institutional platform</p>
          <h3 class="h2" style="font-size:clamp(1.5rem,3vw,2.25rem); margin-top:0.75rem">
            SED — Teacher Evaluation System
          </h3>
          <p class="muted" style="margin-top:1rem">
            An anonymous, tamper-evident evaluation platform for a public
            university in Mexico. Django + React, with an opaque-credential
            system that keeps respondents anonymous and every submission immutable.
          </p>
          <p style="margin-top:1.25rem; display:flex; flex-wrap:wrap; gap:0.5rem">
            <span class="tag">Django</span>
            <span class="tag">React 19</span>
            <span class="tag">PostgreSQL</span>
            <span class="tag">Celery</span>
            <span class="tag">Docker</span>
          </p>
        </div>
        <div aria-hidden="true" style="background:var(--plum-ink); border:1px solid var(--line); border-radius:8px; display:flex; align-items:center; justify-content:center; min-height:220px; padding:2rem">
          <p style="font-family:var(--font-serif); font-style:italic; font-size:clamp(1.5rem,3vw,2.25rem); color:var(--wisteria); text-align:center; line-height:1.3">
            Anonymous.<br />Immutable.<br />Audited.
          </p>
        </div>
      </a>
      <p class="faint" style="margin-top:1rem; font-size:0.875rem">
        More case studies are on the way — recent work includes a video
        streaming stack, a marketplace operations tool, and an automation
        verification gate.
      </p>
    </div>
  </section>

  <!-- PROCESS -->
  <section class="section" style="border-top:1px solid var(--line)">
    <div class="wrap">
      <p class="eyebrow">How I work</p>
      <h2 class="h2" style="margin-top:0.9rem; max-width:26ch">
        No black boxes. You see everything.
      </h2>
      <div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(240px,1fr)); gap:1.25rem; margin-top:2.5rem">
        <article class="card">
          <p class="eyebrow" style="color:var(--text-faint)">01</p>
          <h3 class="h3" style="margin-top:0.5rem">Scope in writing</h3>
          <p class="muted" style="margin-top:0.6rem; font-size:0.9375rem">
            A short, plain-language spec before any code. You approve the
            plan, the timeline, and the price.
          </p>
        </article>
        <article class="card">
          <p class="eyebrow" style="color:var(--text-faint)">02</p>
          <h3 class="h3" style="margin-top:0.5rem">Weekly proof</h3>
          <p class="muted" style="margin-top:0.6rem; font-size:0.9375rem">
            Working software every week on a preview link you can open from
            your phone. No "trust me, it's almost done."
          </p>
        </article>
        <article class="card">
          <p class="eyebrow" style="color:var(--text-faint)">03</p>
          <h3 class="h3" style="margin-top:0.5rem">Tests, not promises</h3>
          <p class="muted" style="margin-top:0.6rem; font-size:0.9375rem">
            Automated tests on the parts that matter. When I say a feature
            works, there's a test proving it.
          </p>
        </article>
        <article class="card">
          <p class="eyebrow" style="color:var(--text-faint)">04</p>
          <h3 class="h3" style="margin-top:0.5rem">You own it all</h3>
          <p class="muted" style="margin-top:0.6rem; font-size:0.9375rem">
            Your domain, your hosting, your code repository. Handover docs
            included. No lock-in, ever.
          </p>
        </article>
      </div>
    </div>
  </section>

  <!-- CTA PANEL — flat plum block, Vercel-panel mood, zero gradient -->
  <section class="section--tight section">
    <div class="wrap">
      <div class="panel" style="text-align:center">
        <h2 class="h2" style="max-width:24ch; margin-inline:auto">
          Have a project in mind? Tell me about it.
        </h2>
        <p class="muted" style="max-width:46ch; margin:1rem auto 0; color:var(--text-dim)">
          I reply within one business day. English or Spanish — whichever
          you prefer.
        </p>
        <div style="display:flex; justify-content:center; gap:0.9rem; margin-top:2rem; flex-wrap:wrap">
          <a class="btn btn--solid" href="/contact/">Get in touch</a>
          <a class="btn" href={`mailto:${site.email}`}>{site.email}</a>
        </div>
      </div>
    </div>
  </section>

  <!-- BLOG -->
  {posts.length > 0 && (
    <section class="section" style="border-top:1px solid var(--line)">
      <div class="wrap">
        <div style="display:flex; justify-content:space-between; align-items:baseline; flex-wrap:wrap; gap:1rem">
          <div>
            <p class="eyebrow">Notes</p>
            <h2 class="h2" style="margin-top:0.9rem">Writing about the craft.</h2>
          </div>
          <a class="link-arrow" href="/blog/">All posts →</a>
        </div>
        <div style="display:grid; gap:0; margin-top:2rem; border-top:1px solid var(--line)">
          {posts.map((post) => (
            <a
              href={`/blog/${post.id}/`}
              style="display:flex; justify-content:space-between; align-items:baseline; gap:1.5rem; padding:1.5rem 0.25rem; border-bottom:1px solid var(--line); text-decoration:none"
            >
              <div>
                <h3 class="h3">{post.data.title}</h3>
                <p class="faint" style="font-size:0.875rem; margin-top:0.25rem">
                  {post.data.description}
                </p>
              </div>
              <time class="faint" datetime={post.data.pubDate.toISOString()} style="white-space:nowrap; font-size:0.875rem">
                {post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
              </time>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}
</BaseLayout>
