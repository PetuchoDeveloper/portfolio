---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site, services } from '../data/site';
import { getCollection } from 'astro:content';
import Still from '../components/Still.astro';
import SitePlate from '../components/SitePlate.astro';
import MethodRail from '../components/MethodRail.astro';
import EvidenceBoard from '../components/EvidenceBoard.astro';

const posts = (await getCollection('blog'))
  .filter((post) => post.data.lang === 'en')
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const heroJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: site.name,
  description: site.description,
  url: site.url,
  email: site.email,
  areaServed: 'Worldwide',
  serviceType: ['Web development', 'Small business websites', 'Full-stack web applications', 'SEO'],
};

const concept = 'Conceptual image generated for this page; not a client photograph.';
---

<BaseLayout
  title={site.name}
  description={site.description}
  jsonLd={heroJsonLd}
>
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <p class="file-kicker">Case file — Kevin Varick (PetuchoDeveloper)</p>
        <h1 class="display">
          Websites<br />that get<br />found.
        </h1>
      </div>
      <div class="hero-board">
        <EvidenceBoard />
      </div>
    </div>
  </section>

  <div class="file-stack">
    <div class="file-stage">
      <article class="file file--orchid" id="work">
      <p class="file-tab tab-label">Work / 04 files</p>
      <div class="wrap">
        <div class="media-split" style="margin-top:0">
          <div>
            <p class="file-kicker">Selected work</p>
            <h2 class="h2">One case study is ready. Three are still being written.</h2>
            <p class="lede" style="margin-top:1.1rem">
              SED handles anonymous evaluations for a public university. It
              shows how I test, document, and ship work that people depend on.
            </p>
            <div class="work-rows">
              <a class="work-row" href="/work/sed/">
                <div>
                  <strong>SED — Teacher Evaluation System</strong>
                  <p class="muted">Anonymous teacher evaluation platform for a public Mexican university. Made in Django, DRF, React, Vite, AWS, GitHub Actions.</p>
                </div>
                <span>Read →</span>
              </a>
              <div class="work-row">
                <div>
                  <strong>Tau</strong>
                  <p class="muted">Write-up in progress. A VOD platform made in Django, React, with a Rust worker. to preserve the native cinema culture of Nayarit</p>
                </div>
                <span class="muted">Pending</span>
              </div>
            </div>
            <p style="margin-top:1.75rem">
              <a class="link-arrow" href="/work/">Open the work folder →</a>
            </p>
          </div>
          <Still
            product
            src="/images/sed/landing.webp"
            alt="Live SED landing page: evaluate teachers, or open the admin panel."
            width={1400}
            height={953}
            caption="SED in production. Two entries, one system."
          />
        </div>
      </div>
      </article>
    </div>

    <div class="file-stage">
      <article class="file" id="offer">
      <p class="file-tab tab-label">Offer</p>
      <div class="wrap">
        <p class="file-kicker">What you get</p>
        <h2 class="h2">A site customers can actually find.</h2>
        <p class="lede" style="margin-top:1.1rem">
          {services[0].summary}
        </p>
        <div class="media-split">
          <Still
            src="/images/shopfront.webp"
            alt={concept}
            width={1400}
            height={788}
            caption="A shop that can be found. Generated concept, not a client storefront."
          />
          <div>
            <SitePlate />
            <p class="muted" style="margin-top:1.5rem">
              I also build full-stack applications. Those projects include a
              security review before launch.
            </p>
            <p style="margin-top:1.25rem">
              <a class="link-arrow" href="/services/">See both offers →</a>
            </p>
          </div>
        </div>
      </div>
      </article>
    </div>

    <div class="file-stage">
      <article class="file file--kraft" id="method">
      <p class="file-tab tab-label">How I work</p>
      <div class="wrap">
        <p class="file-kicker">Method</p>
        <h2 class="h2">You see the work as it takes shape.</h2>
        <p class="lede" style="margin-top:1.1rem; margin-bottom:1.75rem">
          We agree on the scope first. Then you get a working preview each week.
        </p>
        <MethodRail />
      </div>
      </article>
    </div>

    <div class="file-stage">
      <article class="file file--orchid" id="start">
      <p class="file-tab tab-label">Start</p>
      <div class="wrap">
        <div class="media-split" style="margin-top:0">
          <div>
            <p class="file-kicker">Next</p>
            <h2 class="h2">Have a project? Tell me about it.</h2>
            <p class="lede" style="margin-top:1.1rem">
              I reply within one business day. English or Spanish.
            </p>
            <div style="display:flex; flex-wrap:wrap; gap:0.8rem; margin-top:2rem">
              <a class="btn btn--solid" href="/contact/">Start a project</a>
              <a class="btn" href={`mailto:${site.email}`}>{site.email}</a>
            </div>
          </div>
          <Still
            src="/images/found-street.webp"
            alt={concept}
            width={1400}
            height={933}
            caption="The one door that gets found. Generated concept."
          />
        </div>
      </div>
      </article>
    </div>
  </div>

  {posts.length > 0 && (
    <section class="page-hero notes-section" style="padding-top:clamp(4rem,8vw,6rem)">
      <div class="wrap">
        <p class="file-kicker">Notes</p>
        <h2 class="h2">Notes from the work.</h2>
        <div class="post-list" style="margin-top:1.75rem">
          {posts.map((post) => (
            <a class="post-row" href={`/blog/${post.id}/`}>
              <div>
                <h3 class="h3">{post.data.title}</h3>
                <p class="muted" style="font-size:0.9375rem">{post.data.description}</p>
              </div>
              <time datetime={post.data.pubDate.toISOString()}>
                {post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
              </time>
            </a>
          ))}
        </div>
        <p style="margin-top:1.5rem">
          <a class="link-arrow" href="/blog/">All notes →</a>
        </p>
      </div>
    </section>
  )}

  <script is:inline>
    let files = [];
    let frame;

    const measureFileStack = () => {
      document.querySelectorAll('.file').forEach((file) => {
        file.classList.remove('is-pinned', 'is-passed');
        file.style.removeProperty('top');
        file.style.removeProperty('transform');
      });
      document.querySelectorAll('.file-stage').forEach((stage) => stage.style.removeProperty('height'));

      const stages = [...document.querySelectorAll('.file-stage')];
      files = stages.slice(0, -1).map((stage, index) => {
        const file = stage.querySelector('.file');
        const top = stage.getBoundingClientRect().top + window.scrollY;
        const nextStage = stages[index + 1];
        const stageHeight = stage.offsetHeight;
        stage.style.height = `${stageHeight}px`;
        return {
          file,
          pinAt: top + file.offsetHeight - window.innerHeight,
          releaseAt: nextStage.getBoundingClientRect().top + window.scrollY,
          pinnedTop: window.innerHeight - file.offsetHeight,
          state: 'flow',
        };
      });
      updateFileStack();
    };

    const updateFileStack = () => {
      frame = undefined;
      files.forEach((item) => {
        const nextState = window.scrollY < item.pinAt
          ? 'flow'
          : window.scrollY < item.releaseAt
            ? 'pinned'
            : 'passed';

        if (nextState === item.state) return;
        item.file.classList.toggle('is-pinned', nextState === 'pinned');
        item.file.classList.toggle('is-passed', nextState === 'passed');
        if (nextState === 'pinned') item.file.style.top = `${item.pinnedTop}px`;
        else item.file.style.removeProperty('top');
        item.state = nextState;
      });
    };

    const queueFileStackUpdate = () => {
      if (!frame) frame = requestAnimationFrame(updateFileStack);
    };

    const fileObserver = new ResizeObserver(measureFileStack);
    document.querySelectorAll('.file').forEach((file) => fileObserver.observe(file));
    window.addEventListener('resize', measureFileStack, { passive: true });
    window.addEventListener('scroll', queueFileStackUpdate, { passive: true });
    measureFileStack();
  </script>
</BaseLayout>
