---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Página no encontrada" description="Esta página no existe." locale="es" path="/es/404/" alternateEnPath="/404.html">
  <section class="page-hero" style="min-height:60vh; display:flex; align-items:center">
    <div class="wrap">
      <h1 class="display">No hay nada<br />archivado aquí.</h1>
      <p class="lede" style="margin-top:1.5rem">La página que buscas no existe o cambió de lugar.</p>
      <a class="btn btn--solid" style="margin-top:2.25rem" href="/es/">Volver al inicio</a>
    </div>
  </section>
</BaseLayout>
