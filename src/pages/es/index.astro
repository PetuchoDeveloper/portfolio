---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site, servicesEs as services } from '../../data/site';
import { getCollection } from 'astro:content';
import Still from '../../components/Still.astro';
import SitePlate from '../../components/SitePlate.astro';
import MethodRail from '../../components/MethodRail.astro';
import EvidenceBoard from '../../components/EvidenceBoard.astro';

const posts = (await getCollection('blog'))
  .filter((post) => post.data.lang === 'es')
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const heroJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: site.name,
  description: 'Sitios web para pequeños negocios y aplicaciones web confiables, desarrollados en México para clientes de cualquier lugar.',
  url: `${site.url}/es/`,
  email: site.email,
  areaServed: 'Worldwide',
  serviceType: ['Desarrollo web', 'Sitios web para pequeños negocios', 'Aplicaciones web full-stack', 'SEO'],
};

const concept = 'Imagen conceptual generada para esta página; no es una fotografía de un cliente.';
---

<BaseLayout
  title={site.name}
  description="Sitios web para pequeños negocios y aplicaciones web confiables, desarrollados en México para clientes de cualquier lugar."
  jsonLd={heroJsonLd}
  locale="es"
  path="/es/"
>
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <p class="file-kicker">Expediente — Petucho</p>
        <h1 class="display">
          Sitios web<br />fáciles de<br />encontrar.
        </h1>
      </div>
      <div class="hero-board">
        <EvidenceBoard locale="es" />
      </div>
    </div>
  </section>

  <div class="file-stack">
    <div class="file-stage">
      <article class="file file--orchid" id="work">
      <p class="file-tab tab-label">Trabajo / 04 archivos</p>
      <div class="wrap">
        <div class="media-split" style="margin-top:0">
          <div>
            <p class="file-kicker">Trabajo seleccionado</p>
            <h2 class="h2">Un caso de estudio está listo. Los otros tres siguen en proceso.</h2>
            <p class="lede" style="margin-top:1.1rem">
              SED gestiona evaluaciones anónimas para una universidad pública.
              Muestra cómo pruebo, documento y entrego software del que otras personas dependen.
            </p>
            <div class="work-rows">
              <a class="work-row" href="/es/work/sed/">
                <div>
                  <strong>SED — Sistema de Evaluación Docente</strong>
                  <p class="muted">Plataforma anónima para una universidad pública mexicana. Más de 2,500 pruebas.</p>
                </div>
                <span>Leer →</span>
              </a>
              <div class="work-row">
                <div>
                  <strong>Infraestructura de video</strong>
                  <p class="muted">Caso en proceso. Django, React y un worker en Rust.</p>
                </div>
                <span class="muted">Pendiente</span>
              </div>
              <div class="work-row">
                <div>
                  <strong>Operaciones para marketplaces</strong>
                  <p class="muted">Caso en proceso. Panel de control diseñado primero en español.</p>
                </div>
                <span class="muted">Pendiente</span>
              </div>
              <div class="work-row">
                <div>
                  <strong>Control de verificación para automatizaciones</strong>
                  <p class="muted">Caso en proceso. Evita falsos positivos silenciosos.</p>
                </div>
                <span class="muted">Pendiente</span>
              </div>
            </div>
            <p style="margin-top:1.75rem">
              <a class="link-arrow" href="/es/work/">Abrir el archivo de proyectos →</a>
            </p>
          </div>
          <Still
            product
            src="/images/sed/landing.webp"
            alt="Página de inicio de SED en operación: evaluar docentes o abrir el panel administrativo."
            width={1400}
            height={953}
            caption="SED en producción. Dos entradas, un sistema."
          />
        </div>
      </div>
      </article>
    </div>

    <div class="file-stage">
      <article class="file" id="offer">
      <p class="file-tab tab-label">Servicios</p>
      <div class="wrap">
        <p class="file-kicker">Qué recibes</p>
        <h2 class="h2">Un sitio que tus clientes sí pueden encontrar.</h2>
        <p class="lede" style="margin-top:1.1rem">
          {services[0].summary}
        </p>
        <div class="media-split">
          <Still
            src="/images/shopfront.webp"
            alt={concept}
            width={1400}
            height={788}
            caption="Un negocio fácil de encontrar. Imagen conceptual, no es el local de un cliente."
          />
          <div>
            <SitePlate locale="es" />
            <p class="muted" style="margin-top:1.5rem">
              También desarrollo aplicaciones full-stack. Esos proyectos incluyen
              una revisión de seguridad antes del lanzamiento.
            </p>
            <p style="margin-top:1.25rem">
              <a class="link-arrow" href="/es/services/">Ver los dos servicios →</a>
            </p>
          </div>
        </div>
      </div>
      </article>
    </div>

    <div class="file-stage">
      <article class="file file--kraft" id="method">
      <p class="file-tab tab-label">Cómo trabajo</p>
      <div class="wrap">
        <p class="file-kicker">Método</p>
        <h2 class="h2">Ves el proyecto mientras toma forma.</h2>
        <p class="lede" style="margin-top:1.1rem; margin-bottom:1.75rem">
          Primero acordamos el alcance. Después recibes una versión funcional cada semana.
        </p>
        <MethodRail locale="es" />
      </div>
      </article>
    </div>

    <div class="file-stage">
      <article class="file file--orchid" id="start">
      <p class="file-tab tab-label">Empezar</p>
      <div class="wrap">
        <div class="media-split" style="margin-top:0">
          <div>
            <p class="file-kicker">Siguiente paso</p>
            <h2 class="h2">¿Tienes un proyecto? Cuéntame.</h2>
            <p class="lede" style="margin-top:1.1rem">
              Respondo en un día hábil, en español o inglés.
            </p>
            <div style="display:flex; flex-wrap:wrap; gap:0.8rem; margin-top:2rem">
              <a class="btn btn--solid" href="/es/contact/">Cuéntame tu proyecto</a>
              <a class="btn" href={`mailto:${site.email}`}>{site.email}</a>
            </div>
          </div>
          <Still
            src="/images/found-street.webp"
            alt={concept}
            width={1400}
            height={933}
            caption="La puerta que sí encuentran. Imagen conceptual."
          />
        </div>
      </div>
      </article>
    </div>
  </div>

  {posts.length > 0 && (
    <section class="page-hero notes-section" style="padding-top:clamp(4rem,8vw,6rem)">
      <div class="wrap">
        <p class="file-kicker">Notas</p>
        <h2 class="h2">Notas desde el trabajo.</h2>
        <div class="post-list" style="margin-top:1.75rem">
          {posts.map((post) => (
            <a class="post-row" href={`/es/blog/${post.id.split('/').at(-1)}/`}>
              <div>
                <h3 class="h3">{post.data.title}</h3>
                <p class="muted" style="font-size:0.9375rem">{post.data.description}</p>
              </div>
              <time datetime={post.data.pubDate.toISOString()}>
                {post.data.pubDate.toLocaleDateString('es-MX', { year: 'numeric', month: 'short', day: 'numeric' })}
              </time>
            </a>
          ))}
        </div>
        <p style="margin-top:1.5rem">
          <a class="link-arrow" href="/es/blog/">Todas las notas →</a>
        </p>
      </div>
    </section>
  )}

  <script is:inline>
    let files = [];
    let frame;

    const measureFileStack = () => {
      document.querySelectorAll('.file').forEach((file) => {
        file.classList.remove('is-pinned', 'is-passed');
        file.style.removeProperty('top');
        file.style.removeProperty('transform');
      });
      document.querySelectorAll('.file-stage').forEach((stage) => stage.style.removeProperty('height'));

      const stages = [...document.querySelectorAll('.file-stage')];
      files = stages.slice(0, -1).map((stage, index) => {
        const file = stage.querySelector('.file');
        const top = stage.getBoundingClientRect().top + window.scrollY;
        const nextStage = stages[index + 1];
        const stageHeight = stage.offsetHeight;
        stage.style.height = `${stageHeight}px`;
        return {
          file,
          pinAt: top + file.offsetHeight - window.innerHeight,
          releaseAt: nextStage.getBoundingClientRect().top + window.scrollY,
          pinnedTop: window.innerHeight - file.offsetHeight,
          state: 'flow',
        };
      });
      updateFileStack();
    };

    const updateFileStack = () => {
      frame = undefined;
      files.forEach((item) => {
        const nextState = window.scrollY < item.pinAt
          ? 'flow'
          : window.scrollY < item.releaseAt
            ? 'pinned'
            : 'passed';

        if (nextState === item.state) return;
        item.file.classList.toggle('is-pinned', nextState === 'pinned');
        item.file.classList.toggle('is-passed', nextState === 'passed');
        if (nextState === 'pinned') item.file.style.top = `${item.pinnedTop}px`;
        else item.file.style.removeProperty('top');
        item.state = nextState;
      });
    };

    const queueFileStackUpdate = () => {
      if (!frame) frame = requestAnimationFrame(updateFileStack);
    };

    const fileObserver = new ResizeObserver(measureFileStack);
    document.querySelectorAll('.file').forEach((file) => fileObserver.observe(file));
    window.addEventListener('resize', measureFileStack, { passive: true });
    window.addEventListener('scroll', queueFileStackUpdate, { passive: true });
    measureFileStack();
  </script>
</BaseLayout>
