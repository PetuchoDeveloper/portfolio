---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site, servicesEs as services } from '../../data/site';
import HomePage from '../../components/HomePage.astro';

const heroJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  '@id': `${site.url}/#business`,
  founder: { '@id': `${site.url}/#person` },
  address: { '@type': 'PostalAddress', addressCountry: 'MX' },
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Servicios',
    itemListElement: services.map((s) => ({
      '@type': 'Offer',
      itemOffered: { '@type': 'Service', name: s.name, description: s.summary, url: `${site.url}/es/services/#${s.slug}` },
    })),
  },
  name: site.name,
  description: 'Sitios web para pequeños negocios y aplicaciones web confiables, desarrollados en México para clientes de cualquier lugar.',
  url: `${site.url}/es/`,
  email: site.email,
  areaServed: 'Worldwide',
  serviceType: ['Desarrollo web', 'Sitios web para pequeños negocios', 'Aplicaciones web full-stack', 'SEO'],
};
---

<BaseLayout
  title="Sitios web para pequeños negocios y aplicaciones web en México"
  description="Sitios web para pequeños negocios y aplicaciones web confiables, desarrollados en México para clientes de cualquier lugar."
  jsonLd={heroJsonLd}
  locale="es"
  path="/es/"
>
  <HomePage locale="es" />
</BaseLayout>
