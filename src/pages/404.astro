---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" description="This page doesn't exist.">
  <section class="page-hero" style="min-height:60vh; display:flex; align-items:center">
    <div class="wrap">
      <h1 class="display">
        Nothing<br />filed here.
      </h1>
      <p class="lede" style="margin-top:1.5rem">
        The page you're looking for doesn't exist or has moved.
      </p>
      <a class="btn btn--solid" style="margin-top:2.25rem" href="/">Back to the blotter</a>
    </div>
  </section>
</BaseLayout>
