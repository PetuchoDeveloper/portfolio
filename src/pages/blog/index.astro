---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<BaseLayout
  title="Blog"
  description="Notes on web development, SEO, and building software that holds up — from a full-stack developer in Mexico."
>
  <section class="page-hero">
    <div class="wrap">
      <h1 class="display">Notes on the craft.</h1>
      <p class="lede" style="margin-top:1.5rem">
        Practical writing from real projects — performance, SEO, and the
        discipline that keeps software alive.
      </p>

      <div class="post-list" style="margin-top:3rem">
        {posts.map((post) => (
          <a class="post-row" href={`/blog/${post.id}/`}>
            <div>
              <h2 class="h3" style="font-size:1.375rem">{post.data.title}</h2>
              <p class="muted" style="margin-top:0.35rem; font-size:0.9375rem">{post.data.description}</p>
            </div>
            <time datetime={post.data.pubDate.toISOString()}>
              {post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
            </time>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
