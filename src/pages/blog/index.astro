---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<BaseLayout
  title="Blog"
  description="Notes on web development, SEO, and building software that holds up — from a full-stack developer in Mexico."
>
  <section class="section">
    <div class="wrap">
      <p class="eyebrow">Blog</p>
      <h1 class="display" style="margin-top:1.25rem; font-size:clamp(2.2rem,5vw,3.75rem)">
        Notes on the craft.
      </h1>
      <p class="lede" style="margin-top:1.5rem">
        Practical writing from real projects — performance, SEO, and the
        discipline that keeps software alive.
      </p>

      <div style="margin-top:3rem; border-top:1px solid var(--line)">
        {posts.map((post) => (
          <a href={`/blog/${post.id}/`}
            style="display:grid; grid-template-columns:1fr auto; gap:1.5rem; align-items:baseline; padding:1.75rem 0.25rem; border-bottom:1px solid var(--line); text-decoration:none">
            <div>
              <h2 class="h3" style="font-size:1.375rem">{post.data.title}</h2>
              <p class="faint" style="margin-top:0.35rem; font-size:0.9375rem">{post.data.description}</p>
            </div>
            <time class="faint" datetime={post.data.pubDate.toISOString()} style="white-space:nowrap; font-size:0.875rem">
              {post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
            </time>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
