---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Still from '../../components/Still.astro';
---

<BaseLayout
  title="Work"
  description="Selected projects: institutional platforms, streaming infrastructure, and marketplace tooling — built with automated testing and security review as standard."
>
  <section class="page-hero">
    <div class="wrap">
      <h1 class="display">Selected files.</h1>
      <p class="lede" style="margin-top:1.5rem">
        SED is written up. The others are in progress — I will not invent
        a case study to fill a folder.
      </p>
      <div style="margin-top:2rem; max-width:42rem">
        <Still
          src="/images/folders.webp"
          alt="Conceptual image generated for this page; not a client photograph."
          width={1400}
          height={933}
          caption="Four files. One public write-up."
        />
      </div>
    </div>
  </section>

  <section style="padding-bottom:clamp(4rem,8vw,6rem)">
    <div class="wrap" style="display:grid; gap:1.25rem">
      <a class="folder folder--orchid" href="/work/sed/" style="text-decoration:none">
        <p class="tab-label">Flagship · Institutional</p>
        <h2 class="h2" style="margin-top:0.8rem; font-size:clamp(1.6rem,3vw,2.4rem)">SED — Teacher Evaluation System</h2>
        <p class="muted" style="margin-top:0.85rem; max-width:60ch">
          Anonymous evaluation platform for a public Mexican university.
          Opaque credentials, immutable submissions, 2,500+ automated tests,
          full CI/CD to AWS.
        </p>
        <p style="margin-top:1.25rem">Read →</p>
      </a>

      <article class="folder">
        <p class="tab-label">Case study in progress</p>
        <h2 class="h2" style="margin-top:0.8rem; font-size:clamp(1.6rem,3vw,2.4rem)">Video streaming stack</h2>
        <p class="muted" style="margin-top:0.85rem; max-width:60ch">
          Django backend, React frontend, and a Rust video-transcoding worker
          with hardened cloud deployment. Write-up coming soon.
        </p>
      </article>

      <article class="folder">
        <p class="tab-label">Case study in progress</p>
        <h2 class="h2" style="margin-top:0.8rem; font-size:clamp(1.6rem,3vw,2.4rem)">Marketplace operations platform</h2>
        <p class="muted" style="margin-top:0.85rem; max-width:60ch">
          Control-plane tooling for sellers expanding across Latin American
          marketplaces. Spanish-first product design with demand validation
          before a line of production code.
        </p>
      </article>

      <article class="folder">
        <p class="tab-label">Case study in progress</p>
        <h2 class="h2" style="margin-top:0.8rem; font-size:clamp(1.6rem,3vw,2.4rem)">Automation verification gate</h2>
        <p class="muted" style="margin-top:0.85rem; max-width:60ch">
          An independent verification layer for workflow automations:
          deterministic outcome contracts that stop silent false-positive
          executions before they touch real data.
        </p>
      </article>

      <p class="muted" style="font-size:0.875rem">
        Client work is under NDA-friendly review before publishing. Ask me
        about it directly — I'm happy to walk through details on a call.
      </p>
    </div>
  </section>
</BaseLayout>
