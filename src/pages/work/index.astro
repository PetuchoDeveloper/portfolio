---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Still from '../../components/Still.astro';
import { site } from '../../data/site';
---

<BaseLayout
  title="Work"
  description="Selected work in institutional software, video infrastructure, marketplace operations, and workflow verification."
>
  <section class="page-hero">
    <div class="wrap">
      <h1 class="display">Selected files.</h1>
      <p class="lede" style="margin-top:1.5rem">
        SED is fully written up. The other three are still in the works, so
        for now you get the short version of each.
      </p>
      <div style="margin-top:2rem; max-width:42rem">
        <Still
          src="/images/folders.webp"
          alt="Conceptual image generated for this page; not a client photograph."
          width={1400}
          height={933}
          caption="Four files. One public write-up."
        />
      </div>
    </div>
  </section>

  <section style="padding-bottom:clamp(4rem,8vw,6rem)">
    <div class="wrap" style="display:grid; gap:1.25rem">
      <a class="folder folder--orchid" href="/work/sed/" style="text-decoration:none">
        <p class="tab-label">Flagship · Institutional</p>
        <h2 class="h2" style="margin-top:0.8rem; font-size:clamp(1.6rem,3vw,2.4rem)">SED — Teacher Evaluation System</h2>
        <p class="muted" style="margin-top:0.85rem; max-width:60ch">
          Students at a public Mexican university rate their teachers, and
          nobody can trace an answer back to them. Opaque credentials,
          answers that can't be edited, 2,500+ automated tests, and full CI/CD
          to AWS.
        </p>
        <p style="margin-top:1.25rem">Read the case →</p>
      </a>
      <p>
        <a class="link-arrow" href={site.sedLiveUrl} target="_blank" rel="noreferrer">Open the live system →</a>
      </p>

      <article class="folder">
        <p class="tab-label">Case study in progress</p>
        <h2 class="h2" style="margin-top:0.8rem; font-size:clamp(1.6rem,3vw,2.4rem)">Tau — video streaming stack</h2>
        <p class="muted" style="margin-top:0.85rem; max-width:60ch">
          A Django backend, a React frontend, and a Rust worker that transcodes
          the video, all running in the cloud. Write-up coming soon.
        </p>
      </article>

      <article class="folder">
        <p class="tab-label">Case study in progress</p>
        <h2 class="h2" style="margin-top:0.8rem; font-size:clamp(1.6rem,3vw,2.4rem)">Marketplace operations platform</h2>
        <p class="muted" style="margin-top:0.85rem; max-width:60ch">
          Tools for people who sell on Latin American marketplaces. It's
          designed in Spanish first, and I check that people really want it
          before building the production version.
        </p>
      </article>

      <article class="folder">
        <p class="tab-label">Case study in progress</p>
        <h2 class="h2" style="margin-top:0.8rem; font-size:clamp(1.6rem,3vw,2.4rem)">Automation verification gate</h2>
        <p class="muted" style="margin-top:0.85rem; max-width:60ch">
          Before an automated flow can say "done" or touch real data, this
          separate step checks what it actually recorded.
        </p>
      </article>

      <p class="muted" style="font-size:0.875rem">
        I'm still working out what I can show without exposing private client
        details. Happy to walk you through the technical side on a call.
      </p>
    </div>
  </section>
</BaseLayout>
