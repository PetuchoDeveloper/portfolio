---
import BaseLayout from '../layouts/BaseLayout.astro';
import { services } from '../data/site';
import Still from '../components/Still.astro';
import SitePlate from '../components/SitePlate.astro';
---

<BaseLayout
  title="Services"
  description="Websites for small businesses and full-stack web applications. Written scope, weekly working previews, and a full handover."
>
  <section class="page-hero">
    <div class="wrap">
      <h1 class="display">Two ways I can help.</h1>
      <p class="lede" style="margin-top:1.5rem">
        We start with a written scope, price, and delivery date. You get a
        working preview each week. When the project is done, the code, domain,
        and hosting accounts are yours.
      </p>
      <div class="media-split">
        <Still
          src="/images/shopfront.webp"
          alt="Conceptual image generated for this page; not a client photograph."
          width={1400}
          height={788}
          caption="The first offer: a site customers can find."
        />
        <SitePlate />
      </div>
    </div>
  </section>

  <section style="padding-bottom:clamp(4rem,8vw,6rem)">
    <div class="wrap">
      {services.map((s, i) => (
        <article id={s.slug} class:list={['folder', i === 0 && 'folder--orchid']} style="margin-top:1.25rem">
          <div style="display:flex; justify-content:space-between; align-items:baseline; flex-wrap:wrap; gap:0.75rem">
            <h2 class="h2" style="font-size:clamp(1.5rem,3vw,2.25rem)">{s.name}</h2>
            <span class="tag">{s.priority}</span>
          </div>
          <p class="muted" style="margin-top:1rem; max-width:60ch">{s.summary}</p>
          <p class="tab-label" style="margin-top:2rem">What you get</p>
          <ul style="margin-top:0.75rem; padding-left:1.25rem; display:grid; gap:0.5rem; max-width:62ch">
            {s.deliverables.map((d) => (
              <li class="muted">{d}</li>
            ))}
          </ul>
        </article>
      ))}

      <article class="folder" style="margin-top:1.25rem">
        <div style="display:flex; justify-content:space-between; align-items:baseline; flex-wrap:wrap; gap:0.75rem">
          <h2 class="h2" style="font-size:clamp(1.5rem,3vw,2.25rem)">Security review</h2>
          <span class="tag">Included in full-stack builds</span>
        </div>
        <p class="muted" style="margin-top:1rem; max-width:60ch">
          I do not sell standalone security audits. Before I launch an
          application, I review its authentication, sessions, secrets, and
          handling of sensitive data.
        </p>
      </article>

      <div class="folder folder--orchid" style="margin-top:2rem">
        <h2 class="h2">Not sure what you need?</h2>
        <p class="muted" style="margin-top:1rem">
          Describe the problem. I'll tell you whether I can help.
        </p>
        <a class="btn btn--solid" style="margin-top:1.75rem" href="/contact/">Start a conversation</a>
      </div>
    </div>
  </section>
</BaseLayout>
