---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactActions from '../components/ContactActions.astro';
import { site } from '../data/site';
---

<BaseLayout
  title="Contact"
  description={`Contact ${site.name} about a website or web application. Replies within one business day in English or Spanish.`}
>
  <section class="page-hero">
    <div class="wrap split">
      <div>
        <h1 class="display" style="max-width:12ch">Tell me what you need built.</h1>
        <p class="lede" style="margin-top:1.5rem">
          No long forms, no sales call. A few lines are enough: what you
          need, who it's for, and when you want it live. I reply within one
          business day, in English or Spanish.
        </p>
        <div style="margin-top:2.25rem; display:grid; gap:1rem; max-width:34rem">
          <div class="folder" style="padding:1.15rem 1.35rem">
            <p class="tab-label">Email — fastest</p>
            <a class="h3" style="text-decoration:none; color:var(--orchid)" href={`mailto:${site.email}`}>{site.email}</a>
          </div>
          <div class="folder" style="padding:1.15rem 1.35rem">
            <p class="tab-label">Response time</p>
            <p class="muted" style="font-size:0.9375rem">Within 1 business day · {site.location} (GMT-6)</p>
          </div>
        </div>
      </div>

      <ContactActions />
    </div>
  </section>
</BaseLayout>
