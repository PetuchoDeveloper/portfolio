---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
---

<BaseLayout
  title="Contact"
  description={`Start a project with ${site.name}. Describe what you need — a website, a web app, or both — and get a reply within one business day. English or Spanish.`}
>
  <section class="page-hero">
    <div class="wrap split">
      <div>
        <h1 class="display" style="max-width:12ch">Tell me what you need built.</h1>
        <p class="lede" style="margin-top:1.5rem">
          A few sentences are enough — what the project is, who it's for, and
          when you'd like it live. I reply within one business day, in
          English or Spanish.
        </p>
        <div style="margin-top:2.25rem; display:grid; gap:1rem; max-width:34rem">
          <div class="folder" style="padding:1.15rem 1.35rem">
            <p class="tab-label">Email — fastest</p>
            <a class="h3" style="text-decoration:none; color:var(--orchid)" href={`mailto:${site.email}`}>{site.email}</a>
          </div>
          <div class="folder" style="padding:1.15rem 1.35rem">
            <p class="tab-label">What to include</p>
            <p class="muted" style="font-size:0.9375rem">Project type · rough timeline · budget range if you have one</p>
          </div>
          <div class="folder" style="padding:1.15rem 1.35rem">
            <p class="tab-label">Response time</p>
            <p class="muted" style="font-size:0.9375rem">Within 1 business day · {site.location} (GMT-6)</p>
          </div>
        </div>
      </div>

      <form
        class="folder"
        action={`mailto:${site.email}`}
        method="get"
        enctype="text/plain"
        style="display:grid; gap:1rem"
        aria-label="Project inquiry"
      >
        <p class="tab-label">Or draft the email here</p>
        <label class="field">
          <span class="muted">Your name</span>
          <input name="name" required autocomplete="name" />
        </label>
        <label class="field">
          <span class="muted">Your email</span>
          <input name="email" type="email" required autocomplete="email" />
        </label>
        <label class="field">
          <span class="muted">What do you need?</span>
          <textarea name="body" rows="6" required placeholder="A website for my bakery. I need it online before the holiday season…"></textarea>
        </label>
        <button class="btn btn--solid" type="submit">Open email draft</button>
        <p class="muted" style="font-size:0.8125rem">
          No backend, no tracking — this just opens your mail app with the
          message pre-filled. Prefer direct? Write to {site.email}.
        </p>
      </form>
    </div>
  </section>
</BaseLayout>
