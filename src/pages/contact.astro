---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
---

<BaseLayout
  title="Contact"
  description={`Start a project with ${site.name}. Describe what you need — a website, a web app, or both — and get a reply within one business day. English or Spanish.`}
>
  <section class="section">
    <div class="wrap split">
      <div>
        <p class="eyebrow">Contact</p>
        <h1 class="display" style="margin-top:1.25rem; font-size:clamp(2.2rem,5vw,3.5rem); max-width:18ch">
          Tell me what you need built.
        </h1>
        <p class="lede" style="margin-top:1.5rem">
          A few sentences are enough — what the project is, who it's for, and
          when you'd like it live. I reply within one business day, in
          English or Spanish.
        </p>
        <div style="margin-top:2.5rem; display:grid; gap:1rem; max-width:34rem">
          <div class="card" style="padding:1.25rem 1.5rem">
            <p class="eyebrow" style="color:var(--text-faint)">Email — fastest</p>
            <a class="h3" style="text-decoration:none; color:var(--wisteria)" href={`mailto:${site.email}`}>{site.email}</a>
          </div>
          <div class="card" style="padding:1.25rem 1.5rem">
            <p class="eyebrow" style="color:var(--text-faint)">What to include</p>
            <p class="muted" style="font-size:0.9375rem">Project type · rough timeline · budget range if you have one</p>
          </div>
          <div class="card" style="padding:1.25rem 1.5rem">
            <p class="eyebrow" style="color:var(--text-faint)">Response time</p>
            <p class="muted" style="font-size:0.9375rem">Within 1 business day · {site.location} (GMT-6)</p>
          </div>
        </div>
      </div>

      <form
        class="card"
        action={`mailto:${site.email}`}
        method="get"
        enctype="text/plain"
        style="display:grid; gap:1rem"
        aria-label="Project inquiry"
      >
        <p class="eyebrow">Or draft the email here</p>
        <label style="display:grid; gap:0.35rem; font-size:0.9375rem">
          <span class="faint">Your name</span>
          <input name="name" required autocomplete="name"
            style="background:var(--ink); border:1px solid var(--line); border-radius:6px; padding:0.7rem 0.9rem; color:var(--text)" />
        </label>
        <label style="display:grid; gap:0.35rem; font-size:0.9375rem">
          <span class="faint">Your email</span>
          <input name="email" type="email" required autocomplete="email"
            style="background:var(--ink); border:1px solid var(--line); border-radius:6px; padding:0.7rem 0.9rem; color:var(--text)" />
        </label>
        <label style="display:grid; gap:0.35rem; font-size:0.9375rem">
          <span class="faint">What do you need?</span>
          <textarea name="body" rows="6" required placeholder="A website for my bakery. I need it online before the holiday season…"
            style="background:var(--ink); border:1px solid var(--line); border-radius:6px; padding:0.7rem 0.9rem; color:var(--text); resize:vertical"></textarea>
        </label>
        <button class="btn btn--solid" type="submit">Open email draft</button>
        <p class="faint" style="font-size:0.8125rem">
          No backend, no tracking — this just opens your mail app with the
          message pre-filled. Prefer direct? Write to {site.email}.
        </p>
      </form>
    </div>
  </section>
</BaseLayout>
